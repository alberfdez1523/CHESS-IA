{
  "name": "chess-ia-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
