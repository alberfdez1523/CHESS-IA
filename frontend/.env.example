# API. Vacío usa /api; en desarrollo Vite lo proxifica al backend.
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://localhost:8000

# Supabase público para Auth/Realtime del navegador.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Hitos disponibles por defecto.
VITE_FEATURE_ACADEMY=1
VITE_FEATURE_ACCOUNT_SYNC=1
VITE_FEATURE_DAILY_SPRINT=1
VITE_FEATURE_QUANTUM_COHERENCE=1

# Gate de lanzamiento: mantener a 0 hasta completar Checkout y entitlements.
VITE_FEATURE_SUPPORTER=0

# Solo se acepta una URL HTTPS de buy.stripe.com o checkout.stripe.com.
VITE_SUPPORTER_CHECKOUT_URL=
