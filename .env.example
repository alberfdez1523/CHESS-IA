# Backend / API
PORT=8000
SKIP_STOCKFISH=0
STOCKFISH_POOL_SIZE=2
STOCKFISH_QUEUE_TIMEOUT=3

# Verificación de tokens Supabase. Se acepta SUPABASE_ANON_KEY como fallback,
# pero se recomienda la publishable key actual. Nunca expongas service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_CACHE_SECONDS=120

# Solo para pruebas detrás de un proxy local de confianza.
TRUST_AUTH_PROXY=0

# Mantener apagado hasta compartir el Game Core con el servidor y superar carga.
FEATURE_AUTHORITATIVE_QUANTUM=0
